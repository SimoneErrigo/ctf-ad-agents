# ctf-ad-agents app config — copy to .env. Read by the agents app + postgres compose.

# AWS Bedrock credentials.
REGION_NAME=us-east-1
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=

# Bedrock model id per agent.
TRAFFIC_AGENT_MODEL=us.anthropic.claude-sonnet-4-6
PATCH_AGENT_MODEL=us.anthropic.claude-sonnet-4-6
ROUTER_AGENT_MODEL=us.anthropic.claude-haiku-4-5-20251001-v1:0
CHAT_AGENT_MODEL=us.anthropic.claude-haiku-4-5-20251001-v1:0

# LangSmith tracing (optional).
LANGSMITH_API_KEY=
LANGSMITH_TRACING=true
LANGSMITH_ENDPOINT=https://api.smith.langchain.com
LANGSMITH_PROJECT=ctf-ad-agents

# Base URL (host:port) of each MCP server; the agents append the endpoint path.
# The servers themselves are configured in src/janus/.env and src/patcher/.env.
JANUS_MCP_BASE_URL=http://localhost:8765
PATCHER_MCP_BASE_URL=http://localhost:8766

# Postgres — conversation checkpointer.
POSTGRES_DB=ctf_ad_agents
POSTGRES_USER=ctf_ad_agents
POSTGRES_PASSWORD=change-me
POSTGRES_HOST=localhost
POSTGRES_PORT=5432

# CLI conversation thread id.
THREAD_ID=cli-session
