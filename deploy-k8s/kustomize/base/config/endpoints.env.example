# External infra endpoints. Copy this file to endpoints.env and fill in the values

# Janus proxy (REST API)
JANUS_URL=http://192.168.1.45:8080
# Competition VM (where patches are deployed)
VM_IP=192.168.1.20
VM_SSH_USER=ctf_user
VM_SSH_PORT=22
# exploitfarm server
FARM_HOST=192.168.1.30
FARM_PORT=5050
# Flag IDs endpoint + host di test per l'exploit
