# Secrets. Copy this file to secrets.env and fill in the values. Do not commit secrets.env to git.

# AWS Bedrock
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
# Janus (TEAM_PASSWORD del proxy)
JANUS_PASSWORD=
# exploitfarm (leave empty if not using exploitfarm)
FARM_AUTH_KEY=
# LangSmith (free plan). The agent-server Helm chart reads THESE exact key names
# from app-secrets: api_key -> injected as LANGSMITH_API_KEY; empty license = Lite.
api_key=
langgraph_cloud_license_key=
# Postgres (choose a strong password)
POSTGRES_PASSWORD=
