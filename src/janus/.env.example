# janus-mcp config — copy to src/janus/.env. Read by the FastMCP server.

# Janus REST API (JANUS_PASSWORD = Janus' TEAM_PASSWORD).
JANUS_URL=http://janus:8080
JANUS_PASSWORD=changeme
JANUS_DISPLAY_NAME=mcp-agent
JANUS_TIMEOUT=20

# MCP transport bind; endpoints are served at /<agent>/mcp.
JANUS_MCP_HOST=0.0.0.0
JANUS_MCP_PORT=8765

# Caps on tool output sent to agents (protect context).
JANUS_MAX_LIMIT=1000
JANUS_SUMMARY_MAX_LIMIT=50
JANUS_BODY_MAX_BYTES=8192
JANUS_MAX_FLOW_PACKETS=20

# Docker network Janus runs on, so the MCP can reach http://janus:8080.
JANUS_NETWORK=janus_default
