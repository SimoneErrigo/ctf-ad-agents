# When running inside the same Docker network as Janus, use the service name:
JANUS_URL=http://janus:8080
# Password configured in Janus' .env as TEAM_PASSWORD
JANUS_PASSWORD=changeme
# Display name used when logging in to Janus (shown in the Janus sidebar)
JANUS_DISPLAY_NAME=mcp-agent

# Bind address & port for the streamable-HTTP MCP endpoint
MCP_HOST=0.0.0.0
MCP_PORT=8765
MCP_PATH=/mcp

# Hard cap on packets returned by list_packets in one call (protects context)
JANUS_MAX_LIMIT=1000
# When fetching a single packet, truncate body to N bytes (0 = no truncation)
JANUS_BODY_MAX_BYTES=4096
# HTTP request timeout (seconds) for calls to Janus
JANUS_TIMEOUT=15
