# patcher-mcp config, copy to src/patcher/.env.
# Read by the FastMCP server (pydantic-settings) and docker-compose.yml.

# MCP transport bind; single endpoint at PATCHER_MCP_PATH.
PATCHER_MCP_HOST=0.0.0.0
PATCHER_MCP_PORT=8766
PATCHER_MCP_PATH=/mcp

# Workspace: one git working tree per service at <root>/<service>/.
PATCHER_WORKSPACE_ROOT=/var/lib/patcher/workspace
# Map external service names/ids to workspace names.
PATCHER_SERVICE_ALIASES={"web1.1":"cc-forms","CC-Forms-backend":"cc-forms","CCForms":"cc-forms"}

# Default branch + commit identity for the patch agent.
PATCHER_DEFAULT_BRANCH=main
PATCHER_GIT_USER_NAME=patch-agent
PATCHER_GIT_USER_EMAIL=patch-agent@ctf-ad-agents.local

# Competition VM (git push target). Origin = ssh://USER@IP:PORT/REMOTE_ROOT/<service>.git
# Set up the bare repo + post-receive hook once (see src/patcher/README.md).
# Local test: VM_IP=127.0.0.1, your user, a bare repo under your home.
VM_IP=host.docker.internal
VM_SSH_USER=ctf_user
VM_SSH_PORT=22
VM_GIT_REMOTE_ROOT=~/AD-demo/patcher-test/git
# Optional: verify this VM worktree moved to the pushed commit after deploy.
PATCHER_DEPLOY_WORKTREES={"cc-forms":"/path/to/AD-demo/patcher-test/services/cc-forms"}

# SSH private key path INSIDE the container (mounted from PATCHER_SSH_KEY_HOST).
VM_SSH_KEY_PATH=/root/.ssh/id_ed25519
# false: ssh with StrictHostKeyChecking=no (first deploys); true once host key is pinned.
PATCHER_GIT_SSH_STRICT_HOST_CHECK=false

# Caps on tool output sent to the agent (bytes / entries).
PATCHER_MAX_FILE_BYTES=262144
PATCHER_MAX_DIFF_BYTES=524288
PATCHER_MAX_LIST_ENTRIES=500

# docker-compose only: host path of the SSH key mounted at VM_SSH_KEY_PATH (chmod 600).
PATCHER_SSH_KEY_HOST=~/.ssh/ctf_deploy
